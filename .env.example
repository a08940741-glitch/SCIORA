# SCIORA configuration. Copy to .env and fill in locally. NEVER commit .env.
# Values below are placeholders/defaults only. No real secrets belong in this file.

# --- Runtime ---
NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# --- AI mode ---
# "demo" (default): DemoProvider, pre-written simulated content, no AI calls (Wikipedia related reading only).
# "live": real AI. Requires the selected provider's key AND explicit owner approval.
# Setup and first controlled test: docs/LIVE_AI_SETUP.md. Run: npx tsx --env-file=.env src/server.ts
SCIORA_AI_MODE=demo
# Live provider: "anthropic" (default, paid) or "groq" (free tier, open models).
SCIORA_AI_PROVIDER=anthropic
# Server-side only. Never exposed to the browser. Only the selected provider's key is read.
# Leave empty here; set real keys only in your local .env (git-ignored) or a secret store.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Model routing (all configurable) ---
SCIORA_MODEL_LEARN=claude-sonnet-5-5
SCIORA_MODEL_FAST=claude-haiku-5-5
SCIORA_MODEL_REASON=claude-opus-5-5
# Groq model routing (used only with SCIORA_AI_PROVIDER=groq). Check
# https://console.groq.com/docs/models and /docs/deprecations before changing.
SCIORA_GROQ_MODEL_LEARN=openai/gpt-oss-120b
SCIORA_GROQ_MODEL_FAST=openai/gpt-oss-120b
SCIORA_GROQ_MODEL_REASON=openai/gpt-oss-120b
# Re-grade "uncertain" written answers once with the LEARN model (costs more).
SCIORA_GRADE_ESCALATION=off

# --- Exercise token encryption ---
# Required in production: at least 32 random bytes, base64 or hex.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SCIORA_TOKEN_SECRET=
SCIORA_TOKEN_TTL_SECONDS=7200

# --- Replay store ---
SCIORA_REPLAY_MAX_ENTRIES=20000
SCIORA_REPLAY_HIGH_WATER=0.9

# --- Abuse / cost limits ---
SCIORA_RATE_LIMIT_PER_MINUTE=30
# 0 = no daily limit. For any live session (especially the shared Groq free tier) set a cap, e.g. 20.
SCIORA_DAILY_LIMIT=0

# --- Source retrieval ---
# "wikipedia" (default): free public MediaWiki API, no key. "none": disable retrieval.
SCIORA_RETRIEVER=wikipedia
# Wikimedia asks API clients to identify themselves with contact information (URL or email).
SCIORA_WIKI_USER_AGENT=

# --- Live tests (real API calls; only with owner approval) ---
SCIORA_ALLOW_LIVE_TESTS=0
